package com.minibank.start;

import java.util.List;
import java.util.Scanner;

import com.minibank.model.Account;
import com.minibank.service.MiniBankService;

public class MiniBankApplication {

	public static void main(String[] args) {

		Scanner sc = new Scanner(System.in);

		MiniBankService service = new MiniBankService();

		while (true) {

			System.out.println("\n==============================");
			System.out.println("        MINI BANK");
			System.out.println("==============================");
			System.out.println("1. Create Account");
			System.out.println("2. Find Account");
			System.out.println("3. Find All Accounts");
			System.out.println("4. Update Account");
			System.out.println("5. Delete Account");
			System.out.println("6. Exit");
			System.out.println("==============================");

			System.out.print("Enter your choice: ");
			int choice = sc.nextInt();

			try {

				switch (choice) {

				// CREATE
				case 1:

					System.out.println("\n--- CREATE ACCOUNT ---");

					System.out.print("Enter Account Number: ");
					int accno = sc.nextInt();

					sc.nextLine();

					System.out.print("Enter Holder Name: ");
					String holderName = sc.nextLine();

					System.out.print("Enter Balance: ");
					double balance = sc.nextDouble();

					System.out.print("Enter Status (true/false): ");
					boolean status = sc.nextBoolean();

					Account account = new Account(accno, holderName, balance, status);

					service.createAccount(account);

					break;

				// FIND BY ID
				case 2:

					System.out.println("\n--- FIND ACCOUNT ---");

					System.out.print("Enter Account Number: ");
					int searchAccno = sc.nextInt();

					Account foundAccount = service.findById(searchAccno);

					if (foundAccount != null) {

						System.out.println("\nAccount Found");
						System.out.println("------------------------------");
						System.out.println(foundAccount);

					} else {

						System.out.println("Account Not Found");
					}

					break;

				// FIND ALL
				case 3:

					System.out.println("\n==================== ALL ACCOUNTS ====================");

					List<Account> accounts = service.findAll();

					if (accounts.isEmpty()) {

						System.out.println("No Accounts Found");

					} else {

						System.out.println("---------------------------------------------------------------");
						System.out.printf("%-10s %-20s %-15s %-10s%n", "ACC NO", "HOLDER NAME", "BALANCE", "STATUS");
						System.out.println("---------------------------------------------------------------");

						for (Account a : accounts) {

							System.out.printf("%-10d %-20s %-15.2f %-10s%n", a.getAccno(), a.getHolder_name(),
									a.getBalance(), a.isStatus());
						}

						System.out.println("---------------------------------------------------------------");
					}

					break;

				// UPDATE
				case 4:

					System.out.println("\n--- UPDATE ACCOUNT ---");

					System.out.print("Enter Account Number: ");
					int updateAccno = sc.nextInt();

					sc.nextLine();

					System.out.print("Enter New Holder Name: ");
					String updateName = sc.nextLine();

					System.out.print("Enter New Balance: ");
					double updateBalance = sc.nextDouble();

					System.out.print("Enter New Status (true/false): ");
					boolean updateStatus = sc.nextBoolean();

					Account updateAccount = new Account(updateAccno, updateName, updateBalance, updateStatus);

					service.updateAccount(updateAccount);

					break;

				// DELETE
				case 5:

					System.out.println("\n--- DELETE ACCOUNT ---");

					System.out.print("Enter Account Number: ");
					int deleteAccno = sc.nextInt();

					service.deleteAccount(deleteAccno);

					break;

				// EXIT
				case 6:

					System.out.println("\nThank you for using Mini Bank!");

					sc.close();

					return;

				default:

					System.out.println("Invalid Choice!");

				}

			} catch (Exception e) {

				System.out.println("Error: " + e.getMessage());
			}
		}
	}
}